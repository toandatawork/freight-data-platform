# Ghost PostgreSQL — OLTP Source System
# Get these values by running `ghost connect <db-name>` (Ghost CLI/MCP).
# Note: Ghost's internal Postgres database is always named "tsdb", regardless
# of the display name you gave the database (e.g. "freight_oltp").
GHOST_HOST=
GHOST_PORT=5432
GHOST_DATABASE=tsdb
GHOST_USER=
GHOST_PASSWORD=
GHOST_SSLMODE=require

# Databricks
DBX_HOST=
DBX_HTTP_PATH=
DBX_TOKEN=
DBX_JOB_ID=